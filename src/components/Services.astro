---
import type { Lang } from '../i18n/utils';
import { services } from '../i18n/translations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const _ = (s: any) => (typeof s === 'string' ? s : s[lang] || s.pt || '');
---

<section id="services" class="py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">
        04 — {_(services.sectionNum)}
      </div>
      <h2 class="font-display text-4xl md:text-6xl mt-4" set:html={_(services.heading)} />
      <p class="mt-6 text-[color:var(--color-moss)]/80">{_(services.subtitle)}</p>
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        services.cards.map((c) => (
          <div class="rounded-3xl bg-white border border-black/5 p-6">
            <div class="text-3xl" aria-hidden="true">{c.icon}</div>
            <div class="mt-4 text-sm font-medium text-[color:var(--color-emerald)]">{_(c.label)}</div>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-moss)]/80">{_(c.text)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
