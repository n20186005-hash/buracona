---
import type { Lang } from '../i18n/utils';
import { faq } from '../i18n/translations';
import { SITE } from '../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');

const descMap: Record<Lang, string> = {
  zh: 'Buracona - Blue Eye Cave（蓝眼岩洞 / Olho Azul）位于佛得角萨尔岛 Palmeira 的玄武岩海蚀洞与潮汐蓝池，正午阳光折射出深蓝光，每日 09:00–18:00 开放。',
  en: 'Buracona - Blue Eye Cave near Palmeira, Sal, Cape Verde — a basalt sea-cave and tide-pool system where midday sunlight refracts through seawater into an intense blue glow. Open 09:00–18:00.',
  cri: 'Buracona - Blue Eye Cave perto de Palmeira, Sal, Cabo Verde — sistema di gruta di mar i poça di maré na basalto, undi luz di mei-dia ta refrata na água i ta da un azul forte. Abertu 09:00–18:00.',
  pt: 'Buracona - Blue Eye Cave perto de Palmeira, Sal, Cabo Verde — um sistema de gruta marinha e poça de maré em basalto onde a luz do meio-dia se refrata na água e cria um azul intenso. Aberto 09:00–18:00.',
};

const url = new URL(Astro.url.pathname, Astro.site).href;

const tourist = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${SITE.domain}/#attraction`,
  name: SITE.attractionFullName,
  alternateName: [SITE.attractionShortName, `${SITE.city} ${SITE.attractionFullName}`],
  description: descMap[lang],
  url,
  image: [new URL(SITE.heroImage, Astro.site).href],
  isAccessibleForFree: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.attractionFullName,
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    postalCode: SITE.postalCode,
    addressCountry: SITE.countryCode,
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.latitude, longitude: SITE.longitude },
  openingHours: SITE.openingHours,
  hasMap: SITE.mapsShareUrl,
  sameAs: [SITE.mapsShareUrl, SITE.govTourismUrl],
});

// FAQPage built from the localized faq.items (HTML stripped for plain-text answers)
const stripHtml = (s: string) => s.replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const faqData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: _(item.q),
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(_(item.a)) },
  })),
});

const breadcrumb = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.country, item: `https://${SITE.domain}` },
    { '@type': 'ListItem', position: 2, name: SITE.region, item: `https://${SITE.domain}` },
    { '@type': 'ListItem', position: 3, name: SITE.city, item: `https://${SITE.domain}` },
    { '@type': 'ListItem', position: 4, name: SITE.attractionFullName, item: url },
  ],
});
---
<Fragment set:html={'<script type="application/ld+json">' + tourist + '</script><script type="application/ld+json">' + faqData + '</script><script type="application/ld+json">' + breadcrumb + '</script>'} />
