---
import type { Lang } from '../i18n/utils';
import { itineraries } from '../i18n/translations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const _ = (s: any) => (typeof s === 'string' ? s : s[lang] || s.pt || '');
---

<section id="itineraries" class="bg-[color:var(--color-mist)] py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">
        05 — {_(itineraries.sectionNum)}
      </div>
      <h2 class="font-display text-4xl md:text-6xl mt-4" set:html={_(itineraries.heading)} />
      <p class="mt-6 text-[color:var(--color-moss)]/80">{_(itineraries.subtitle)}</p>
    </div>

    <div class="mt-14">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">
        {_(itineraries.peopleTitle)}
      </div>
      <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          itineraries.people.map((p) => (
            <div class="rounded-3xl bg-white border border-black/5 p-6 md:p-7">
              <div class="text-3xl" aria-hidden="true">{p.icon}</div>
              <div class="mt-3 text-lg font-medium text-[color:var(--color-ink)]">{_(p.title)}</div>
              <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-moss)]/80">{_(p.text)}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">
        {_(itineraries.generalTitle)}
      </div>
      <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-5">
        {
          [itineraries.half, itineraries.full].map((route) => (
            <div class="rounded-3xl bg-white border border-black/5 p-6 md:p-7">
              <div class="flex items-center justify-between gap-3">
                <div class="text-lg font-medium text-[color:var(--color-ink)]">{_(route.title)}</div>
                <div class="text-xs text-[color:var(--color-emerald)] bg-[color:var(--color-emerald)]/10 px-3 py-1 rounded-full whitespace-nowrap">
                  {_(route.meta)}
                </div>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-[color:var(--color-moss)]/80">{_(route.steps)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
