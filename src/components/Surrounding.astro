---
import type { Lang } from '../i18n/utils';
import { surrounding } from '../i18n/translations';
import { SITE } from '../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');
---
<section class="bg-[color:var(--color-mist)] py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">10 — {_(surrounding.sectionNum)}</div>
    <h2 class="font-display text-4xl md:text-6xl mt-4 mb-8 max-w-3xl" set:html={_(surrounding.heading)} />
    <p class="max-w-3xl text-[color:var(--color-moss)]/80 leading-relaxed mb-14" set:html={_(surrounding.intro)} />
    <div class="grid md:grid-cols-3 gap-5">
      {surrounding.items.map((card) => (
        <article class="rounded-3xl bg-white overflow-hidden card-hover">
          <img src={card.img} alt={`${_(card.title)} near ${SITE.attractionShortName}, ${SITE.city}`} loading="lazy" class="w-full aspect-[4/3] object-cover" />
          <div class="p-6"><h3 class="font-display text-2xl">{_(card.title)}</h3>
          <p class="mt-2 text-[color:var(--color-moss)] text-sm leading-relaxed">{_(card.desc)}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
