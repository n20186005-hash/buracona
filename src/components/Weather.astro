---
import type { Lang } from '../i18n/utils';
import { weather } from '../i18n/translations';
import { SITE } from '../data/site';
import { getWeather } from '../data/weather';
import { renderWeatherHtml } from '../data/weatherView';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const _ = (s: any) => typeof s === 'string' ? s : (s[lang] || s.pt || '');

// Resolve a whole group of translation keys for the current language.
const mapT = (o: Record<string, any>) =>
  Object.fromEntries(Object.entries(o).map(([k, v]) => [k, _(v)]));

const LOCALE = lang === 'zh' ? 'zh-CN' : lang === 'pt' || lang === 'cri' ? 'pt-PT' : 'en-US';

const labels = {
  ...mapT(weather),
  cond: mapT(weather.cond),
  uv: mapT(weather.uv),
  wind: mapT(weather.wind),
  adv: mapT(weather.adv),
};

// Fetched server-side (cached + de-duplicated); the client refreshes it live.
const data = await getWeather(SITE.latitude, SITE.longitude);
const initialHtml = renderWeatherHtml(data, labels, LOCALE);
const labelsJson = JSON.stringify(labels).replace(/</g, '\\u003c');
---
<section id="weather" class="max-w-7xl mx-auto px-6 py-24 md:py-32">
  <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-emerald)]">06 — {_(weather.sectionNum)}</div>
  <h2 class="font-display text-4xl md:text-6xl mt-4 mb-8" set:html={_(weather.heading)} />
  <p class="max-w-2xl text-[color:var(--color-moss)]/80 mb-12">{_(weather.subtitle)}</p>
  <div id="weather-root" data-lat={SITE.latitude} data-lng={SITE.longitude} data-locale={LOCALE} set:html={initialHtml} />
</section>

<script type="application/json" id="weather-i18n" set:html={labelsJson} />

<script>
  import { getWeather } from '../data/weather';
  import { renderWeatherHtml } from '../data/weatherView';

  const root = document.getElementById('weather-root');
  if (root) {
    const lat = parseFloat(root.dataset.lat || '0');
    const lng = parseFloat(root.dataset.lng || '0');
    const locale = root.dataset.locale || 'en-US';
    let labels: Record<string, any> = {};
    try {
      labels = JSON.parse(document.getElementById('weather-i18n')?.textContent || '{}');
    } catch (_e) {
      labels = {};
    }
    // Refresh with live values once the page is interactive.
    getWeather(lat, lng).then((d) => {
      if (d && root.isConnected) root.innerHTML = renderWeatherHtml(d, labels, locale);
    });
  }
</script>
